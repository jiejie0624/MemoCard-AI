# Use Neon's pooled connection URL for the Render API service.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require

# Server-side only. Do not prefix either variable with VITE_.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# Local HTTP development only. Keep unset in Render so session cookies stay Secure.
APP_ENV=development

# Render API: comma-separated exact Vercel frontend origins, including https://.
FRONTEND_ORIGINS=
# Set to none on Render for cross-site Vercel-to-Render session cookies; local defaults to lax.
COOKIE_SAMESITE=lax

# Vercel frontend build: set to the Render service URL after creating the API service.
VITE_API_BASE_URL=

# Local/outside-Vercel Blob access. Vercel private Blob uses its connected store credentials.
BLOB_READ_WRITE_TOKEN=
